echo "Practica 3 - IDS Snort | Leslie De Los Santos | Matricula: 20261154"
cat /etc/os-release | head -4
hostname -I
sudo subscription-manager repos --enable codeready-builder-for-rhel-$(rpm -E %rhel)-$(arch)-rpms
sudo dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-$(rpm -E %rhel).noarch.rpm
sudo dnf install -y gcc gcc-c++ make cmake git flex bison autoconf automake libtool \
  pkgconf-pkg-config libpcap-devel pcre2-devel openssl-devel zlib-devel \
  hwloc-devel luajit-devel libdnet-devel libtirpc-devel xz-devel libuuid-devel
mkdir ~/snort-src && cd ~/snort-src
git clone https://github.com/snort3/libdaq.git
cd libdaq
./bootstrap
./configure
make -j$(nproc)
sudo make install
echo "/usr/local/lib" | sudo tee /etc/ld.so.conf.d/local.conf
sudo ldconfig
cd ~/snort-src
git clone https://github.com/snort3/snort3.git
cd snort3
export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH
./configure_cmake.sh --prefix=/usr/local
cd build
make -j$(nproc)
sudo make install
sudo ldconfig
/usr/local/bin/snort -V
IP=$(hostname -I | awk '{print $1}')
sudo mkdir -p /usr/local/etc/rules
sudo tee /usr/local/etc/rules/local.rules <<EOF
alert icmp any any -> $IP any (msg:"ICMP Ping detectado hacia el host"; sid:1000001; rev:1;)
alert tcp any any -> $IP 21 (msg:"Trafico FTP puerto 21 detectado"; sid:1000002; rev:1;)
alert tcp any any -> $IP 22 (msg:"Trafico SSH puerto 22 detectado"; sid:1000003; rev:1;)
alert tcp any any -> $IP 80 (msg:"Trafico HTTP puerto 80 detectado"; sid:1000004; rev:1;)
EOF
cat /usr/local/etc/rules/local.rules
sudo /usr/local/bin/snort -c /usr/local/etc/snort/snort.lua -R /usr/local/etc/rules/local.rules -T
sudo /usr/local/bin/snort -c /usr/local/etc/snort/snort.lua -R /usr/local/etc/rules/local.rules -i ens33 -A alert_fast -k none
